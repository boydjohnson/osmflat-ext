/// osmflat extension archive: inverted tag index, taginfo histograms, and
/// reverse references for an existing `osm.Osm` archive.
///
/// This is a *sibling* archive: it never modifies the parent `Osm` archive and
/// is meaningless without it. All `*_idx` fields that name strings are indices
/// into the **parent** `Osm.stringtable`; all `Ref.value` fields are indices
/// into the **parent** `nodes` / `ways` / `relations` vectors. flatdata has no
/// cross-archive reference concept, so these are plain `u40` values interpreted
/// against the parent at query time (see `ExtHeader` for the staleness guard).

namespace osm_ext {

/// Special value which represents an invalid index (matches `osm.INVALID_IDX`).
const u64 INVALID_IDX = 0xFFFFFFFFFF;

/**
 * Fingerprint of the exact parent `Osm` archive this sidecar was built from.
 *
 * A sidecar hard-codes parent entity indices and parent stringtable indices,
 * both of which change whenever the parent is recompiled or reordered. The
 * query layer compares this against the live parent and refuses to serve any
 * query on mismatch.
 */
struct ExtHeader {
    /// Hash of the parent's embedded schema bytes (`osm.flatdata`).
    parent_schema_hash: u64 : 64;
    /// Parent vector lengths at build time (cheap; catches rebuilds/reorders).
    parent_node_count: u64 : 40;
    parent_way_count: u64 : 40;
    parent_relation_count: u64 : 40;
    parent_tags_count: u64 : 40;
    parent_stringtable_len: u64 : 64;
    /// Parent replication sequence number, or 0 if absent.
    parent_replication_sequence_number: i64 : 64;
    /// Writing program / tool version (index into this archive's `stringtable`).
    builder_idx: u64 : 40;
}

// ---------------------------------------------------------------------------
// Taginfo: key -> value -> postings  (inverted tag index + histograms)
// ---------------------------------------------------------------------------

/**
 * A distinct OSM key. Entries in `keys` are sorted by key **string** (not by
 * `key_idx`), so a key can be found by binary search / prefix scan.
 */
struct KeyEntry {
    /// Key string, index into the parent `Osm.stringtable`.
    key_idx: u64 : 40;
    /**
     * Number of entities carrying this key, split by type (O(1) key stats).
     * A key's total is not derivable from value postings without summing, so
     * it is stored; OSM keys are unique per object, so no double counting.
     */
    count_nodes: u64 : 40;
    count_ways: u64 : 40;
    count_relations: u64 : 40;
    /// Range of this key's distinct values in `values`.
    @range(values)
    value_first_idx: u64 : 40;
    /// Range of other keys used by objects that have this key.
    @range(combos)
    combo_first_idx: u64 : 40;
}

/**
 * A distinct value for a given key. Within one key's value range, entries are
 * sorted by value **string**. Per-(key,value) per-type counts are NOT stored:
 * they equal the corresponding postings range length.
 */
struct ValueEntry {
    /// Value string, index into the parent `Osm.stringtable`.
    value_idx: u64 : 40;
    /**
     * Postings of entities having this exact (key,value), one range per type.
     * Postings are ascending parent indices == spatial (SFC) order, so they
     * merge-join with bbox ranges and with each other.
     */
    @range(node_post)
    node_first_idx: u64 : 40;
    @range(way_post)
    way_first_idx: u64 : 40;
    @range(rel_post)
    rel_first_idx: u64 : 40;
    /// Range of other tags used by objects that have this exact key=value.
    @range(tag_combos)
    tag_combo_first_idx: u64 : 40;
}

/// A reference into the parent `nodes` / `ways` / `relations` vector.
struct Ref {
    value: u64 : 40;
}

/// A key co-occurrence entry for taginfo combinations.
struct ComboEntry {
    /// Other key string, index into the parent `Osm.stringtable`.
    other_key_idx: u64 : 40;
    /// Number of parent entities carrying this key and `other_key_idx`.
    together_count: u64 : 40;
}

/// A tag co-occurrence entry for taginfo combinations.
struct TagComboEntry {
    /// Other key string, index into the parent `Osm.stringtable`.
    other_key_idx: u64 : 40;
    /// Other value string, index into the parent `Osm.stringtable`.
    other_value_idx: u64 : 40;
    /// Number of parent entities carrying this tag and the other tag.
    together_count: u64 : 40;
}

/// Generic 1:n range holder, one per parent entity (or key), parallel to a
/// parent vector.
struct Range {
    @range(post)
    first_idx: u64 : 40;
}

/**
 * Precomputed `key=*` postings: for each key, the entities carrying it with any
 * value, ascending. Built with `osmflat-extc --key-postings`; without it,
 * readers derive the same lists by merging the key's value postings.
 */
archive KeyPostings {
    /// Parallel to `Taginfo.keys` (plus a trailing sentinel); slices `nodes`.
    node_range: vector< Range >;
    /// Ascending node indices, grouped by key.
    nodes: vector< Ref >;
    /// Parallel to `Taginfo.keys` (plus a trailing sentinel); slices `ways`.
    way_range: vector< Range >;
    /// Ascending way indices, grouped by key.
    ways: vector< Ref >;
    /// Parallel to `Taginfo.keys` (plus a trailing sentinel); slices `relations`.
    relation_range: vector< Range >;
    /// Ascending relation indices, grouped by key.
    relations: vector< Ref >;
}

/// One distinct trigram and the values containing it.
struct Trigram {
    /**
     * Three bytes of an ASCII-lowercased value string, big-endian
     * (`b0 << 16 | b1 << 8 | b2`). Non-ASCII bytes are kept as-is.
     */
    gram: u32 : 24;
    /// Range of the values containing this trigram in `ValueSearch.values`.
    @range(values)
    value_first_idx: u64 : 40;
}

/**
 * Trigram index over distinct value strings, for ASCII case-insensitive
 * substring search. Built with `osmflat-extc --value-search`.
 */
archive ValueSearch {
    /// Distinct trigrams, ascending by `gram`. Trailing sentinel.
    trigrams: vector< Trigram >;
    /// Indices into `Taginfo.values`, ascending within each trigram's range.
    values: vector< Ref >;
}

/**
 * Inverted tag index and taginfo histograms.
 */
archive Taginfo {
    /**
     * Distinct keys, sorted by key string. Trailing sentinel closes the last
     * key's `values` range.
     */
    keys: vector< KeyEntry >;
    /**
     * Distinct values, grouped by key, sorted by value string within a key.
     * Trailing sentinel closes the last value's postings ranges.
     */
    values: vector< ValueEntry >;
    /// Per-(key,value) node postings (ascending node indices).
    node_post: vector< Ref >;
    /// Per-(key,value) way postings (ascending way indices).
    way_post: vector< Ref >;
    /// Per-(key,value) relation postings (ascending relation indices).
    rel_post: vector< Ref >;
    /**
     * Per-key co-occurring keys, sorted by descending together_count and then
     * key string. Empty unless built with `osmflat-extc --combinations`.
     */
    combos: vector< ComboEntry >;
    /**
     * Per-tag co-occurring tags, sorted by descending together_count and then
     * key/value string. Empty unless built with `osmflat-extc --combinations`.
     */
    tag_combos: vector< TagComboEntry >;
    /**
     * Each key's values ordered by total object count (nodes + ways +
     * relations) descending, then by value string: for key range `[s, e)` in
     * `values`, `values_by_count[s..e]` holds that range's indices into
     * `values`, most common first.
     */
    values_by_count: vector< Ref >;

    /// Precomputed `key=*` postings (`osmflat-extc --key-postings`).
    @optional
    key_postings: archive KeyPostings;

    /// Trigram substring index over value strings (`osmflat-extc --value-search`).
    @optional
    value_search: archive ValueSearch;
}

// ---------------------------------------------------------------------------
// Backrefs: reverse references (node -> ways, X -> relations)
// ---------------------------------------------------------------------------

/**
 * Reverse references. Each `*_range` vector is parallel to a parent entity
 * vector (plus a trailing sentinel) and slices the matching postings vector.
 */
archive Backrefs {
    /// Parallel to parent `nodes`: ways referencing each node.
    node_ways_range: vector< Range >;
    /// Way indices, grouped by referenced node, ascending.
    ways_of_node: vector< Ref >;

    /// Parallel to parent `nodes`: relations whose members include each node.
    node_rels_range: vector< Range >;
    rels_of_node: vector< Ref >;

    /// Parallel to parent `ways`: relations whose members include each way.
    way_rels_range: vector< Range >;
    rels_of_way: vector< Ref >;

    /// Parallel to parent `relations`: relations whose members include a relation.
    rel_rels_range: vector< Range >;
    rels_of_rel: vector< Ref >;
}

// ---------------------------------------------------------------------------
// Multipolygons: precomputed relation ring assembly
// ---------------------------------------------------------------------------

/**
 * Precomputed multipolygon relation assembly.
 *
 * A `type=multipolygon`/`type=boundary` relation's outer/inner member ways
 * have to be stitched end-to-end into closed rings before they mean anything
 * as an area -- the same ring-assembly work `osmflat-mapnik-plugin`'s live
 * rendering path otherwise repeats on every single render query. This
 * archive does that stitching once, at sidecar-build time (`osmflat-extc
 * --multipolygons`), mirroring how the wider OSM rendering ecosystem handles
 * the equivalent coastline-assembly problem with a dedicated offline tool
 * (`osmcoastline`) rather than live, per-query assembly.
 *
 * Rings are stored as **parent node indices**, not coordinates -- consistent
 * with every other resource in this archive, a sidecar holds parent indices,
 * never a copy of parent data. A query resolves each node index's `(lon,
 * lat)` from the parent `nodes` vector directly.
 *
 * Relations that aren't area relations, or whose outer ways don't assemble
 * into at least one closed ring, get an empty `rel_polygon_range` slice here
 * (zero polygons) -- callers needing the leftover *open* chains for such
 * relations (rare; mostly diagnostic) still need the live assembly path in
 * `osmflat_ext::multipolygon`, which this archive's builder also uses.
 */
archive Multipolygons {
    /**
     * Parallel to parent `relations` (plus a trailing sentinel). Slices
     * `polygon_ring_range` for this relation's assembled polygons; empty for
     * non-area relations and relations that failed to close.
     */
    rel_polygon_range: vector< Range >;

    /**
     * One entry per assembled polygon, grouped by relation. Slices
     * `ring_node_range` for this polygon's rings.
     */
    polygon_ring_range: vector< Range >;

    /**
     * One entry per ring, grouped by polygon. Ring 0 within a polygon's
     * range is the exterior; any further rings are holes. Slices `nodes`.
     */
    ring_node_range: vector< Range >;

    /**
     * Assembled ring vertices as parent node indices, in stitched order
     * (first index == last index, closing the ring). Grouped by ring.
     */
    nodes: vector< Ref >;
}

// ---------------------------------------------------------------------------
// Coastline: precomputed global coastline ring assembly + land/water split
// ---------------------------------------------------------------------------

/**
 * One assembled coastline ring. Unlike `Multipolygons`, this isn't indexed by
 * relation -- coastline is a plain way tag, and a ring can be stitched from
 * ways that were never relation members at all.
 */
struct CoastlineRingEntry {
    /**
     * 1 if this ring's interior is land (the ring winds counter-clockwise,
     * per the `natural=coastline` "land on the left" convention -- the usual
     * case, an island's or continent's outer boundary); 0 if its interior is
     * water fully enclosed by coastline (clockwise winding -- rarer, a large
     * inland sea). See `osmflat_ext::coastline`'s module docs.
     */
    is_land: u8 : 1;
    /// Range of this ring's vertices in `nodes`.
    @range(nodes)
    node_first_idx: u64 : 40;
}

/**
 * Precomputed global coastline assembly: every `natural=coastline` way in the
 * archive stitched into closed rings, once, at build time
 * (`osmflat-extc --coastline`) -- mirroring how `osmcoastline` does the
 * equivalent job for the standard OSM rendering pipeline, rather than leaving
 * renderers with only a coastline *line* and no fillable area (the gap this
 * project found for the open ocean, the Harlem River, and the Upper/Lower
 * New York Bay connection at the Narrows -- all mapped as coastline banks
 * with no separate water polygon).
 */
archive Coastline {
    /**
     * One entry per assembled ring, sorted by enclosed area **descending**.
     * Rendering rings in this order (largest first) with a plain painter's
     * algorithm reconstructs arbitrarily deep nesting -- an island in a bay
     * in a sea in a larger bay -- with no explicit hole/exterior pairing.
     */
    rings: vector< CoastlineRingEntry >;
    /**
     * Ring vertices as parent node indices, in stitched order (first index
     * == last index, closing the ring). Grouped by ring.
     */
    nodes: vector< Ref >;
}

// ---------------------------------------------------------------------------
// LandPolygons: imported from an external, already-closed coastline dataset
// ---------------------------------------------------------------------------

/**
 * A scaled `(lon, lat)` coordinate, using the **parent archive's own**
 * `header.coord_scale`, for consistency -- even though this data has no
 * other correspondence to the parent (see `LandPolygons`'s own docs).
 */
struct Coord {
    lon: i32 : 32;
    lat: i32 : 32;
}

/// One ring imported from an external land-polygons dataset.
struct LandPolygonRingEntry {
    /**
     * 1 if this ring should be painted as land; 0 if it's a hole (e.g. a
     * lake within a landmass) that should be left as background/water.
     * Derived the same way as `CoastlineRingEntry.is_land` -- our own
     * signed-area computation on the (already reprojected) ring, not by
     * trusting the source dataset's own stated winding convention.
     */
    is_land: u8 : 1;
    /// Range of this ring's vertices in `coords`.
    @range(coords)
    coord_first_idx: u64 : 40;
}

/**
 * Land polygons imported from an external, already-closed coastline dataset
 * (`osmflat-extc --land-polygons <shapefile-dir>`) -- typically the
 * `land-polygons` (or `water-polygons`) dataset published at
 * osmdata.openstreetmap.de, the same data the standard OSM rendering
 * pipeline's `osmcoastline`-based tooling produces and consumes. Unlike
 * every other resource in this archive, ring vertices here are **not**
 * parent node indices: this data doesn't come from the parent archive at
 * all (it has no OSM ids, no correspondence to any parent node), so it's
 * stored as raw coordinates instead -- a deliberate, documented exception to
 * this sidecar's usual "store indices, not data" rule. This is what
 * `osmflat-mapnik-plugin`'s own coastline-assembly-from-scratch approach
 * (`Coastline`, above) could not solve on its own: a mainland coastline
 * chain never closes into a ring using only what's in a country-clipped OSM
 * extract (it runs off toward an inland border with no coastline tag at
 * all), and neither does a single-direction ray-cast test generalize to
 * open chains (see the project's notes -- this is a real, verified
 * mathematical limitation, not a bug). A dataset that was properly closed
 * against the real global coastline (planet-scale, not clipped to any one
 * country) sidesteps the problem entirely.
 */
archive LandPolygons {
    /**
     * One entry per ring, sorted by enclosed area **descending** -- same
     * painter's-algorithm convention as `Coastline`.
     */
    rings: vector< LandPolygonRingEntry >;
    /// Ring vertices as raw scaled coordinates. Grouped by ring.
    coords: vector< Coord >;
}

// ---------------------------------------------------------------------------
// Umbrella archive
// ---------------------------------------------------------------------------

/**
 * Sibling extension archive for an `osm.Osm` archive. Each capability is an
 * optional sub-archive, built independently (`--taginfo`, `--backrefs`).
 */
archive Ext {
    /// Fingerprint of the parent archive this sidecar indexes.
    @explicit_reference( ExtHeader.builder_idx, stringtable )
    header: ExtHeader;

    /// String storage for this archive's own metadata (e.g. builder version).
    stringtable: raw_data;

    /// Inverted tag index + taginfo histograms.
    @optional
    taginfo: archive Taginfo;

    /// Reverse references.
    @optional
    backrefs: archive Backrefs;

    /// Precomputed multipolygon relation assembly.
    @optional
    multipolygons: archive Multipolygons;

    /// Precomputed global coastline ring assembly.
    @optional
    coastline: archive Coastline;

    /// Land polygons imported from an external, already-closed coastline dataset.
    @optional
    land_polygons: archive LandPolygons;
}

} // namespace osm_ext
